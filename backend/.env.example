# ================================================================
# SISTEMA DE GESTÃO DE CONTRATOS E FATURAMENTO
# Copie este arquivo para .env e preencha os valores
# ================================================================

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/contratos_db

# Segurança (gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-segura-de-64-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ambiente
ENVIRONMENT=development

# CORS — domínios permitidos em produção (separar por vírgula)
# ALLOWED_ORIGINS=https://seudominio.com.br,https://app.seudominio.com.br

# Anthropic API — opcional, usado no módulo 06 (validação IA)
# ANTHROPIC_API_KEY=sk-ant-...
